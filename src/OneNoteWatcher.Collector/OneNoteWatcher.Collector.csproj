<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OneNoteWatcher.Core\OneNoteWatcher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.16" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- parity with the tray: a dev run from bin\ finds a config instead of reporting one missing -->
    <None Include="..\..\config.ini" Link="config.ini" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
